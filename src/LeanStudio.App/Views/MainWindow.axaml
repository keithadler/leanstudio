<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LeanStudio.App.ViewModels"
        xmlns:ed="using:LeanStudio.App.Editor"
        xmlns:v="using:LeanStudio.App.Views"
        xmlns:ver="using:LeanStudio.Core.Verification"
        xmlns:tc="using:LeanStudio.Core.Toolchains"
        x:Class="LeanStudio.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1440" Height="900" MinWidth="900" MinHeight="560"
        Icon="/Assets/leanstudio.ico"
        DragDrop.AllowDrop="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PanelBackground}">

  <Window.KeyBindings>
    <KeyBinding Gesture="{OnPlatform Default='Ctrl+S', macOS='Cmd+S'}" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="{OnPlatform Default='Ctrl+Shift+S', macOS='Cmd+Shift+S'}" Command="{Binding SaveAllCommand}" />
    <KeyBinding Gesture="{OnPlatform Default='Ctrl+O', macOS='Cmd+O'}" Command="{Binding OpenFileDialogCommand}" />
    <KeyBinding Gesture="{OnPlatform Default='Ctrl+N', macOS='Cmd+N'}" Command="{Binding NewFileCommand}" />
    <KeyBinding Gesture="{OnPlatform Default='Ctrl+W', macOS='Cmd+W'}" Command="{Binding CloseDocumentCommand}" />
    <KeyBinding Gesture="{OnPlatform Default='Ctrl+B', macOS='Cmd+B'}" Command="{Binding BuildCommand}" />
    <KeyBinding Gesture="{OnPlatform Default='Ctrl+Shift+V', macOS='Cmd+Shift+V'}" Command="{Binding VerifyCommand}" />
    <KeyBinding Gesture="{OnPlatform Default='Ctrl+G', macOS='Cmd+L'}" Command="{Binding GoToLineCommand}" />
    <KeyBinding Gesture="{OnPlatform Default='Ctrl+Shift+D', macOS='Cmd+Shift+D'}" Command="{Binding ShowDeclarationAtCaretCommand}" />
    <KeyBinding Gesture="{OnPlatform Default='Ctrl+Shift+R', macOS='Cmd+Shift+R'}" Command="{Binding RestartServerCommand}" />
    <KeyBinding Gesture="F2" Command="{Binding RenameSymbolCommand}" />
    <KeyBinding Gesture="F8" Command="{Binding NextProblemCommand}" />
    <KeyBinding Gesture="Shift+F8" Command="{Binding PreviousProblemCommand}" />
    <KeyBinding Gesture="{OnPlatform Default='Ctrl+Shift+N', macOS='Cmd+Shift+N'}" Command="{Binding NewWindowCommand}" />
    <KeyBinding Gesture="Shift+F12" Command="{Binding FindReferencesCommand}" />
  </Window.KeyBindings>

  <DockPanel>
    <!-- Menu -->
    <Menu DockPanel.Dock="Top" Classes="chrome">
      <MenuItem Header="_File">
        <MenuItem Header="New Project…" Command="{Binding NewProjectCommand}" />
        <MenuItem Header="New File…" Command="{Binding NewFileCommand}" InputGesture="{OnPlatform Default='Ctrl+N', macOS='Cmd+N'}" />
        <Separator />
        <MenuItem Header="Open Folder…" Command="{Binding OpenFolderCommand}" />
        <MenuItem Header="Open File…" Command="{Binding OpenFileDialogCommand}" InputGesture="{OnPlatform Default='Ctrl+O', macOS='Cmd+O'}" />
        <MenuItem Header="Clone Repository…" Command="{Binding CloneRepositoryCommand}" />
        <MenuItem x:Name="RecentMenu" Header="Open Recent" />
        <MenuItem Header="New Window" Command="{Binding NewWindowCommand}" InputGesture="{OnPlatform Default='Ctrl+Shift+N', macOS='Cmd+Shift+N'}" />
        <Separator />
        <MenuItem Header="Save" Command="{Binding SaveCommand}" InputGesture="{OnPlatform Default='Ctrl+S', macOS='Cmd+S'}" />
        <MenuItem Header="Save As…" Command="{Binding SaveAsCommand}" />
        <MenuItem Header="Save All" Command="{Binding SaveAllCommand}" InputGesture="{OnPlatform Default='Ctrl+Shift+S', macOS='Cmd+Shift+S'}" />
        <MenuItem Header="Auto Save" ToggleType="CheckBox" IsChecked="{Binding Settings.AutoSave}" Click="OnApplySettings" />
        <MenuItem Header="Local History…" Click="OnLocalHistory" />
        <Separator />
        <MenuItem Header="Export Proof Walkthrough…" Command="{Binding ExportWalkthroughCommand}" />
        <MenuItem Header="Open in the Lean 4 Web Editor" Command="{Binding OpenInWebEditorCommand}" />
        <MenuItem Header="Copy Share Link" Command="{Binding CopyShareLinkCommand}" />
        <MenuItem Header="Close File" Command="{Binding CloseDocumentCommand}" InputGesture="{OnPlatform Default='Ctrl+W', macOS='Cmd+W'}" />
        <Separator />
        <MenuItem Header="Preferences…" Click="OnPreferences" InputGesture="{OnPlatform Default='Ctrl+OemComma', macOS='Cmd+OemComma'}" />
        <Separator />
        <MenuItem Header="Exit" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="Undo" Click="OnUndo" InputGesture="{OnPlatform Default='Ctrl+Z', macOS='Cmd+Z'}" />
        <MenuItem Header="Redo" Click="OnRedo" InputGesture="{OnPlatform Default='Ctrl+Y', macOS='Cmd+Shift+Z'}" />
        <Separator />
        <MenuItem Header="Find…" Click="OnFind" InputGesture="{OnPlatform Default='Ctrl+F', macOS='Cmd+F'}" />
        <MenuItem Header="Replace…" Click="OnReplace" InputGesture="{OnPlatform Default='Ctrl+H', macOS='Cmd+Alt+F'}" />
        <MenuItem Header="Find in Files…" Click="OnFindInFiles" InputGesture="{OnPlatform Default='Ctrl+Shift+F', macOS='Cmd+Shift+F'}" />
        <Separator />
        <MenuItem Header="Unicode Input (\alpha → α)" ToggleType="CheckBox" IsChecked="{Binding Settings.UnicodeInput}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Command Palette…" Click="OnCommandPalette" InputGesture="{OnPlatform Default='Ctrl+Shift+P', macOS='Cmd+Shift+P'}" />
        <Separator />
        <MenuItem Header="Dark Theme" Click="OnDarkTheme" />
        <MenuItem Header="Light Theme" Click="OnLightTheme" />
        <Separator />
        <MenuItem Header="Larger Font" Click="OnFontBigger" InputGesture="{OnPlatform Default='Ctrl+OemPlus', macOS='Cmd+OemPlus'}" />
        <MenuItem Header="Smaller Font" Click="OnFontSmaller" InputGesture="{OnPlatform Default='Ctrl+OemMinus', macOS='Cmd+OemMinus'}" />
        <MenuItem Header="Line Numbers" ToggleType="CheckBox" IsChecked="{Binding Settings.ShowLineNumbers}" Click="OnApplySettings" />
        <MenuItem Header="Word Wrap" ToggleType="CheckBox" IsChecked="{Binding Settings.WordWrap}" Click="OnApplySettings" InputGesture="Alt+Z" />
        <MenuItem Header="Show Who Changed the Current Line" ToggleType="CheckBox" IsChecked="{Binding Settings.ShowBlame}" Click="OnApplySettings" />
        <Separator />
        <MenuItem Header="Toggle Sidebar" Click="OnToggleSidebar" InputGesture="{OnPlatform Default='Ctrl+Alt+B', macOS='Cmd+Alt+B'}" />
        <MenuItem Header="Toggle Bottom Panel" Click="OnTogglePanel" InputGesture="{OnPlatform Default='Ctrl+J', macOS='Cmd+J'}" />
        <MenuItem Header="Toggle Tactic State" Click="OnToggleInfo" InputGesture="{OnPlatform Default='Ctrl+Alt+I', macOS='Cmd+Alt+I'}" />
        <MenuItem Header="Zen Mode (just the editor and the goals)" Click="OnZen" InputGesture="{OnPlatform Default='Ctrl+Alt+Z', macOS='Cmd+Alt+Z'}" />
      </MenuItem>
      <MenuItem Header="_Go">
        <MenuItem Header="Go to File…" Click="OnQuickOpen" InputGesture="{OnPlatform Default='Ctrl+P', macOS='Cmd+P'}" />
        <MenuItem Header="Go to Symbol in Workspace…" Click="OnGoToSymbol" InputGesture="{OnPlatform Default='Ctrl+T', macOS='Cmd+T'}" />
        <MenuItem Header="Go to Line…" Command="{Binding GoToLineCommand}" InputGesture="{OnPlatform Default='Ctrl+G', macOS='Cmd+L'}" />
        <Separator />
        <MenuItem Header="Back" Command="{Binding GoBackCommand}" InputGesture="{OnPlatform Default='Alt+Left', macOS='Ctrl+OemMinus'}" />
        <MenuItem Header="Forward" Command="{Binding GoForwardCommand}" InputGesture="{OnPlatform Default='Alt+Right', macOS='Ctrl+Shift+OemMinus'}" />
        <MenuItem Header="Next Problem" Command="{Binding NextProblemCommand}" InputGesture="F8" />
        <MenuItem Header="Previous Problem" Command="{Binding PreviousProblemCommand}" InputGesture="Shift+F8" />
        <Separator />
        <MenuItem Header="Go to Definition" Command="{Binding GoToDefinitionCommand}" InputGesture="F12" />
        <MenuItem Header="Find References" Command="{Binding FindReferencesCommand}" InputGesture="Shift+F12" />
        <MenuItem Header="Show Declaration in Library" Command="{Binding ShowDeclarationAtCaretCommand}" InputGesture="{OnPlatform Default='Ctrl+Shift+D', macOS='Cmd+Shift+D'}" />
      </MenuItem>
      <MenuItem Header="_Lean">
        <MenuItem Header="Quick Fix / Try This…" Click="OnQuickFix" InputGesture="{OnPlatform Default='Ctrl+OemPeriod', macOS='Cmd+OemPeriod'}" />
        <MenuItem Header="Rename Symbol…" Command="{Binding RenameSymbolCommand}" InputGesture="F2" />
        <MenuItem Header="Rename This Module…" Click="OnRenameModule" />
        <MenuItem Header="Fix All in File" Command="{Binding FixAllInFileCommand}" InputGesture="{OnPlatform Default='Ctrl+Alt+OemPeriod', macOS='Cmd+Alt+OemPeriod'}" />
        <MenuItem Header="Apply Lean's Suggestions Automatically" ToggleType="CheckBox" IsChecked="{Binding Settings.AutoApplyFixes}" Click="OnApplySettings" />
        <MenuItem Header="Show Compiled C" Click="OnShowC" />
        <Separator />
        <MenuItem Header="Prove It (try tactics on this sorry)" Command="{Binding ProveItCommand}" InputGesture="{OnPlatform Default='Ctrl+Alt+P', macOS='Cmd+Alt+P'}" />
        <MenuItem Header="Prove Every Sorry in File" Command="{Binding ProveAllSorriesCommand}" />
        <MenuItem Header="Extract Goal as Lemma…" Command="{Binding ExtractLemmaCommand}" />
        <MenuItem Header="Profile File (where the time goes)" Command="{Binding ProfileFileCommand}" />
        <MenuItem Header="REPL (evaluate Lean at the cursor)" Click="OnShowRepl" InputGesture="{OnPlatform Default='Ctrl+Alt+R', macOS='Cmd+Alt+R'}" />
        <Separator />
        <MenuItem Header="Restart File (rebuild its imports)" Command="{Binding RestartFileCommand}" />
        <MenuItem Header="Restart Server" Command="{Binding RestartServerCommand}" InputGesture="{OnPlatform Default='Ctrl+Shift+R', macOS='Cmd+Shift+R'}" />
        <MenuItem Header="Refresh File Dependencies" Command="{Binding RefreshFileDependenciesCommand}" />
        <Separator />
        <MenuItem Header="Build Project" Command="{Binding BuildCommand}" InputGesture="{OnPlatform Default='Ctrl+B', macOS='Cmd+B'}" />
        <MenuItem Header="Run Task…" Click="OnRunTask" InputGesture="{OnPlatform Default='Ctrl+Shift+B', macOS='Cmd+Shift+B'}" />
        <MenuItem Header="Run Shell Command…" Click="OnRunShell" />
        <MenuItem Header="Get Mathlib Cache" Command="{Binding GetMathlibCacheCommand}" />
        <MenuItem Header="Update Dependencies" Command="{Binding UpdateDependenciesCommand}" />
        <MenuItem Header="Clean Build" Command="{Binding CleanCommand}" />
        <MenuItem Header="Cancel Running Task" Command="{Binding CancelTaskCommand}" />
      </MenuItem>
      <MenuItem Header="_Git">
        <MenuItem Header="Source Control" Click="OnShowGit" />
        <MenuItem Header="Commit All…" Click="OnCommitAll" />
        <MenuItem Header="Push" Command="{Binding SourceControl.PushCommand}" />
        <MenuItem Header="Pull" Command="{Binding SourceControl.PullCommand}" />
        <MenuItem Header="Sync (Pull, then Push)" Command="{Binding SourceControl.SyncCommand}" />
        <MenuItem Header="New Branch…" Command="{Binding SourceControl.NewBranchCommand}" />
        <Separator />
        <MenuItem Header="Clone Repository…" Command="{Binding CloneRepositoryCommand}" />
        <MenuItem Header="Publish to GitHub…" Command="{Binding SourceControl.PublishToGitHubCommand}" />
        <MenuItem Header="Create Pull Request…" Command="{Binding SourceControl.CreatePullRequestCommand}" />
        <MenuItem Header="Open on GitHub" Command="{Binding SourceControl.OpenOnGitHubCommand}" />
        <MenuItem Header="Add Lean CI Workflow" Command="{Binding SourceControl.AddCiWorkflowCommand}" />
      </MenuItem>
      <MenuItem Header="_Tenet">
        <MenuItem Header="Verify Project" Command="{Binding VerifyCommand}" InputGesture="{OnPlatform Default='Ctrl+Shift+V', macOS='Cmd+Shift+V'}" />
        <MenuItem Header="Verify After Every Build" ToggleType="CheckBox" IsChecked="{Binding Settings.VerifyAfterBuild}" />
        <MenuItem Header="Why Isn't This Proved?" Command="{Binding WhyNotProvedAtCaretCommand}" />
        <MenuItem Header="Project Map…" Command="{Binding ShowProjectMapCommand}" />
      </MenuItem>
      <MenuItem Header="_AI">
        <MenuItem Header="Connect an AI Assistant…" Click="OnConnectAssistant" />
      </MenuItem>
      <MenuItem Header="L_earn">
        <MenuItem Header="Start the Lean Tutorial" Command="{Binding Learn.StartTutorialCommand}" />
        <MenuItem Header="Open the Playground" Command="{Binding Learn.OpenPlaygroundCommand}" />
        <MenuItem Header="Famous Theorems and Symbols" Click="OnShowLearn" />
        <MenuItem Header="Insert a Snippet…" Click="OnInsertSnippet" />
        <Separator />
        <MenuItem Header="Show Goals in Plain English" ToggleType="CheckBox" IsChecked="{Binding Info.ShowEnglish}" />
        <MenuItem Header="Explain Lean's Messages" ToggleType="CheckBox" IsChecked="{Binding Settings.ExplainErrors}" Click="OnApplySettings" />
        <MenuItem Header="Show #eval Results at the End of the Line" ToggleType="CheckBox" IsChecked="{Binding Settings.InlineResults}" Click="OnApplySettings" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="Check for Updates…" Command="{Binding CheckForUpdatesNowCommand}" />
        <MenuItem Header="Check for Updates Automatically" ToggleType="CheckBox" IsChecked="{Binding Settings.CheckForUpdates}" Click="OnApplySettings" />
        <Separator />
        <MenuItem Header="Keyboard Shortcuts" Click="OnShortcuts" />
        <MenuItem Header="Keith Adler (@keithadler) on X" Click="OnAuthor" />
        <Separator />
        <MenuItem Header="About Lean Studio" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource StatusBackground}" Padding="10,3">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Column="0" Text="{Binding ServerStatus}" Foreground="White" FontSize="12" Margin="0,0,16,0" />
        <TextBlock Grid.Column="1" Text="{Binding ProblemSummary}" Foreground="White" FontSize="12" Margin="0,0,16,0" Cursor="Hand" PointerPressed="OnProblemsClicked" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
          <ProgressBar IsIndeterminate="True" Width="80" MinWidth="80" Height="4" VerticalAlignment="Center" />
          <TextBlock Text="{Binding BusyText}" Foreground="White" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal">
          <TextBlock Text="{Binding BlameText}" Foreground="White" Opacity="0.75" FontSize="12" Margin="16,0,0,0" MaxWidth="420" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding BlameText}" />
          <TextBlock Text="{Binding CaretLabel}" Foreground="White" FontSize="12" Margin="16,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0" IsVisible="{Binding ActiveDocument.IsProcessing, FallbackValue=False}">
          <ProgressBar IsIndeterminate="True" Width="36" MinWidth="36" Height="3" MinHeight="3" VerticalAlignment="Center" Foreground="White" />
          <TextBlock Text="checking" Foreground="White" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Column="5" Orientation="Horizontal">
          <TextBlock Text="{Binding BranchLabel}" Foreground="White" FontSize="12" Margin="16,0,0,0" Cursor="Hand" PointerPressed="OnBranchClicked" />
          <TextBlock Text="{Binding ProjectName}" Foreground="White" FontSize="12" Margin="16,0,0,0" />
        </StackPanel>
        <TextBlock Grid.Column="6" Text="{Binding ToolchainLabel}" Foreground="White" FontSize="12" Margin="16,0,0,0" />
      </Grid>
    </Border>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Classes="toolbar">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="tool" Command="{Binding NewProjectCommand}" ToolTip.Tip="Create a Lean project">
          <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconPlus}" /><TextBlock Text="New Project" /></StackPanel>
        </Button>
        <Button Classes="tool" Command="{Binding OpenFolderCommand}" ToolTip.Tip="Open a project folder">
          <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconFolder}" /><TextBlock Text="Open Folder" /></StackPanel>
        </Button>
        <Button Classes="tool" Command="{Binding SaveCommand}" ToolTip.Tip="Save (⌘S / Ctrl+S)">
          <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconSave}" /><TextBlock Text="Save" /></StackPanel>
        </Button>
        <Border Width="1" Height="18" Margin="6,0" Background="{DynamicResource Divider}" />
        <Button Classes="tool" Command="{Binding RunProgramCommand}" IsVisible="{Binding CanRun}"
                ToolTip.Tip="Run this file's main function; the output appears in Output">
          <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconPlay}" Foreground="#3FB950" /><TextBlock Text="Run" /></StackPanel>
        </Button>
        <Button Classes="tool" Command="{Binding BuildCommand}" ToolTip.Tip="lake build (⌘B / Ctrl+B)">
          <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconBuild}" /><TextBlock Text="Build" /></StackPanel>
        </Button>
        <Button Classes="tool" Command="{Binding VerifyCommand}" ToolTip.Tip="Re-check every declaration Lean built with Tenet's independent kernel (⌘⇧V / Ctrl+Shift+V)">
          <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconShield}" Classes="accent" /><TextBlock Text="Verify with Tenet" /></StackPanel>
        </Button>
        <Button Classes="tool" Command="{Binding ProveItCommand}" ToolTip.Tip="Try a portfolio of tactics on the sorry at the cursor (⌘⌥P / Ctrl+Alt+P)">
          <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconBolt}" Foreground="#E5B93A" /><TextBlock Text="Prove It" /></StackPanel>
        </Button>
        <Border Width="1" Height="18" Margin="6,0" Background="{DynamicResource Divider}" />
        <Button Classes="tool" Command="{Binding GetMathlibCacheCommand}" ToolTip.Tip="Download Mathlib's prebuilt files (lake exe cache get)">
          <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconDownload}" /><TextBlock Text="Mathlib Cache" /></StackPanel>
        </Button>
        <Button Classes="tool" Command="{Binding RestartServerCommand}" ToolTip.Tip="Restart Lean (⌘⇧R / Ctrl+Shift+R)">
          <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconRestart}" /><TextBlock Text="Restart Lean" /></StackPanel>
        </Button>
        <Button Classes="tool" Command="{Binding CancelTaskCommand}" IsVisible="{Binding IsBusy}" ToolTip.Tip="Stop the running task">
          <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconStop}" Foreground="#F14C4C" /><TextBlock Text="Cancel" /></StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <!-- Update available -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding HasUpdate}" Background="{DynamicResource CurrentStepBackground}" Padding="12,6">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="⬆" FontSize="14" VerticalAlignment="Center" />
          <TextBlock Text="{Binding UpdateText}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <ProgressBar Value="{Binding UpdateProgress}" Maximum="100" Width="120" MinWidth="120" IsVisible="{Binding IsDownloadingUpdate}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <Button Content="Download" Classes="accent" Command="{Binding DownloadUpdateCommand}" FontSize="12" Padding="10,3" />
          <Button Content="What's new" Command="{Binding OpenReleaseNotesCommand}" Classes="chip" />
          <Button Content="Skip this version" Command="{Binding SkipUpdateCommand}" Classes="chip" />
          <Button Classes="flat" Content="×" Command="{Binding DismissUpdateCommand}" FontSize="14" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="MainGrid" ColumnDefinitions="300,4,*,4,420">
      <!-- Sidebar -->
      <TabControl Grid.Column="0" Classes="panel" SelectedIndex="{Binding SidebarTab}" Padding="0">
        <TabItem Header="Files">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding ProjectName}" FontWeight="SemiBold" Margin="10,6" />
            <TreeView x:Name="FileTree" ItemsSource="{Binding Files}" DoubleTapped="OnFileDoubleTapped" SelectionChanged="OnFileSelected">
              <TreeView.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="New File…" Click="OnTreeNewFile" />
                  <MenuItem Header="New Folder…" Click="OnTreeNewFolder" />
                  <Separator />
                  <MenuItem Header="Rename…" Click="OnTreeRename" />
                  <MenuItem Header="Move to Trash" Click="OnTreeTrash" />
                  <Separator />
                  <MenuItem Header="Reveal in File Manager" Click="OnTreeReveal" />
                  <MenuItem Header="Open in Terminal" Click="OnTreeTerminal" />
                  <MenuItem Header="Copy Path" Click="OnTreeCopyPath" />
                  <MenuItem Header="Copy Relative Path" Click="OnTreeCopyRelative" />
                </ContextMenu>
              </TreeView.ContextMenu>
              <TreeView.ItemContainerTheme>
                <ControlTheme TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}" x:DataType="vm:FileNode">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  <Setter Property="MinHeight" Value="24" />
                </ControlTheme>
              </TreeView.ItemContainerTheme>
              <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:FileNode">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{Binding IconKey, Converter={x:Static vm:StatusConverters.Icon}}" Width="13" Height="13"
                              Classes.folder="{Binding IsDirectory}" Classes.lean="{Binding IsLean}" Classes.plain="{Binding IsPlain}" />
                    <TextBlock Text="{Binding Name}" FontSize="13" />
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </DockPanel>
        </TabItem>
        <TabItem Header="Outline">
          <ListBox ItemsSource="{Binding Outline}" Background="Transparent" x:Name="OutlineList" Tapped="OnOutlineTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:OutlineItem">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding Indent}" FontSize="12" />
                  <TextBlock Text="{Binding Icon}" Width="16" FontSize="12" Foreground="{DynamicResource GoalAccent}" />
                  <TextBlock Text="{Binding Name}" Classes="mono" FontSize="12" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Kind}" Classes="dim" FontSize="10" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Status}" FontSize="12" Classes.ok="{Binding IsProved}" Classes.warn="{Binding IsIncomplete}" Classes.bad="{Binding IsBroken}"
                             ToolTip.Tip="✓ Lean accepts it   ◐ uses sorry   ✗ has an error" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>
        <TabItem Header="Library" ToolTip.Tip="Every declaration the project can see, read from the compiled library">
          <v:NavigatorView DataContext="{Binding Navigator}" />
        </TabItem>
        <TabItem Header="Git" ToolTip.Tip="Source control and GitHub">
          <v:SourceControlView DataContext="{Binding SourceControl}" />
        </TabItem>
        <TabItem Header="Lean" ToolTip.Tip="Lean toolchains">
          <v:ToolchainsView DataContext="{Binding Toolchains}" />
        </TabItem>
        <TabItem Header="Learn" ToolTip.Tip="Tutorial, playground, famous theorems and symbols">
          <v:LearnView DataContext="{Binding Learn}" />
        </TabItem>
      </TabControl>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

      <!-- Editor and bottom panel -->
      <Grid x:Name="CenterGrid" Grid.Column="2" RowDefinitions="Auto,*,4,220">
        <TabStrip x:Name="DocTabs" Grid.Row="0" Classes="docs" ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument}">
          <TabStrip.ItemTemplate>
            <DataTemplate x:DataType="vm:DocumentViewModel">
              <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{Binding Path}">
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                <Button Classes="flat" Content="×" FontSize="13" Padding="4,0" VerticalAlignment="Center"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseDocumentCommand}" CommandParameter="{Binding}" />
              </StackPanel>
            </DataTemplate>
          </TabStrip.ItemTemplate>
        </TabStrip>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*">
          <Border Grid.Row="0" IsVisible="{Binding LeanMissing}" Background="{DynamicResource CurrentStepBackground}" Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Lean is not installed yet. Lean Studio can install it for you with the official installer (elan and the latest stable Lean, a few hundred MB)."
                         TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Install Lean" Classes="accent" Command="{Binding InstallLeanCommand}" IsEnabled="{Binding !InstallingLean}" Margin="12,0,0,0" />
            </Grid>
          </Border>
          <Border Grid.Row="1" IsVisible="{Binding ImportsStale}" Background="{DynamicResource CurrentStepBackground}" Padding="12,6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="A file this one imports has changed. Rebuild the imports and check this file again?" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Rebuild imports and recheck" Classes="accent" Command="{Binding RestartFileCommand}" Margin="12,0,0,0" />
            </Grid>
          </Border>
          <ed:LeanEditor Grid.Row="2" x:Name="Editor" Document="{Binding ActiveDocument}" Main="{Binding}" />
          <v:WelcomeView Grid.Row="2" IsVisible="{Binding !HasDocument}" />
        </Grid>

        <GridSplitter Grid.Row="2" ResizeDirection="Rows" Background="Transparent" />

        <TabControl Grid.Row="3" Classes="panel" SelectedIndex="{Binding BottomTab}" Padding="0">
          <TabItem Header="{Binding ProblemSummary, StringFormat='Problems  {0}'}">
            <Panel>
            <ListBox ItemsSource="{Binding Problems}" DoubleTapped="OnProblemDoubleTapped" x:Name="ProblemList" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProblemItem">
                  <StackPanel Orientation="Horizontal" Spacing="8" ToolTip.Tip="{Binding FullMessage}">
                    <TextBlock Text="{Binding Icon}" Width="18" FontSize="11" VerticalAlignment="Center" TextAlignment="Center"
                               Classes.bad="{Binding IsError}" Classes.warn="{Binding IsWarning}" />
                    <TextBlock Text="{Binding File}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Location}" Classes="dim" />
                    <TextBlock Text="{Binding Message}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
              <TextBlock Classes="empty" Text="No problems. Errors and warnings from Lean and from builds appear here." IsVisible="{Binding Problems.Count, Converter={x:Static vm:StatusConverters.IsZero}}" />
            </Panel>
          </TabItem>
          <TabItem Header="Output">
            <ed:OutputView x:Name="OutputView" />
          </TabItem>
          <TabItem Header="Tenet">
            <v:VerificationView DataContext="{Binding Verification}" />
          </TabItem>
          <TabItem Header="{Binding ReferencesTitle}">
            <Panel>
            <ListBox ItemsSource="{Binding References}" Background="Transparent" DoubleTapped="OnLocationDoubleTapped">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LocationItem">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding File}" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="{Binding Where}" Classes="dim" FontSize="12" />
                    <TextBlock Text="{Binding Text}" Classes="mono" FontSize="12" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
              <TextBlock Classes="empty" Text="Find References (⇧F12 / Shift+F12) on a name lists every place it is used." IsVisible="{Binding References.Count, Converter={x:Static vm:StatusConverters.IsZero}}" />
            </Panel>
          </TabItem>
          <TabItem Header="{Binding MarkersTitle}">
            <DockPanel Margin="8,4">
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Every sorry, admit and TODO in the project. Click one: the cursor lands on it and the Tactic State shows what is left to prove."
                           Classes="dim" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560" />
                <Button Content="Refresh" Command="{Binding RefreshMarkersCommand}" Classes="chip" />
              </StackPanel>
              <Panel>
              <ListBox ItemsSource="{Binding Markers}" Background="Transparent" Margin="0,4,0,0" Tapped="OnMarkerTapped">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:MarkerItem">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Kind}" FontSize="11" Width="42" Classes.warn="{Binding IsSorry}" Classes.dim="{Binding !IsSorry}" />
                      <TextBlock Text="{Binding File}" FontWeight="SemiBold" FontSize="12" />
                      <TextBlock Text="{Binding Where}" Classes="dim" FontSize="12" />
                      <TextBlock Text="{Binding Declaration}" Classes="mono" FontSize="12" Foreground="{DynamicResource GoalAccent}" />
                      <TextBlock Text="{Binding Text}" Classes="mono dim" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
                <TextBlock Classes="empty" Text="No sorry, admit or TODO in the project. Everything is proved." IsVisible="{Binding Markers.Count, Converter={x:Static vm:StatusConverters.IsZero}}" />
              </Panel>
            </DockPanel>
          </TabItem>
          <TabItem Header="Search">
            <DockPanel Margin="8,4">
              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBox x:Name="SearchBox" Text="{Binding SearchQuery}" PlaceholderText="Find in files (Enter to search)" FontSize="12" KeyDown="OnSearchKey" />
                <CheckBox Grid.Column="1" Content="Aa" IsChecked="{Binding SearchCaseSensitive}" ToolTip.Tip="Match case" Margin="8,0,0,0" />
                <CheckBox Grid.Column="2" Content=".*" IsChecked="{Binding SearchRegex}" ToolTip.Tip="Regular expression" Margin="4,0,0,0" />
                <Button Grid.Column="3" Content="Search" Command="{Binding SearchInFilesCommand}" Classes="chip" Margin="6,0,0,0" />
              </Grid>
              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <TextBox Text="{Binding ReplaceWith}" PlaceholderText="Replace with ($1, $2… for regex groups)" FontSize="12" />
                <Button Grid.Column="1" Content="Replace All…" Click="OnReplaceAll" Classes="chip" Margin="6,0,0,0"
                        ToolTip.Tip="Replace every match in the project; open files are edited in place, unsaved" />
              </Grid>
              <TextBlock DockPanel.Dock="Top" Text="{Binding SearchStatus}" Classes="dim" FontSize="11" Margin="2,4" />
              <Panel>
              <ListBox ItemsSource="{Binding SearchResults}" Background="Transparent" DoubleTapped="OnLocationDoubleTapped">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LocationItem">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding File}" FontWeight="SemiBold" FontSize="12" />
                      <TextBlock Text="{Binding Where}" Classes="dim" FontSize="12" />
                      <TextBlock Text="{Binding Text}" Classes="mono" FontSize="12" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
                <TextBlock Classes="empty" Text="Matches in every file of the project appear here." IsVisible="{Binding SearchResults.Count, Converter={x:Static vm:StatusConverters.IsZero}}" />
              </Panel>
            </DockPanel>
          </TabItem>
          <TabItem Header="Timing" ToolTip.Tip="How long each declaration takes Lean to check (Lean ▸ Profile File)">
            <DockPanel Margin="8,4">
              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding TimingStatus}" Classes="dim" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Profile this file" Command="{Binding ProfileFileCommand}" IsEnabled="{Binding !IsProfiling}" Classes="chip" Margin="8,0,0,0" />
              </Grid>
              <Panel>
              <ListBox ItemsSource="{Binding TimingItems}" Background="Transparent" Margin="0,4,0,0" x:Name="TimingList" Tapped="OnTimingTapped">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TimingItem">
                    <Grid ColumnDefinitions="126,70,70,*" ToolTip.Tip="{Binding HotSpot}">
                      <Border Height="8" Width="{Binding BarWidth}" HorizontalAlignment="Left" CornerRadius="2" Classes="bar"
                              Classes.warm="{Binding IsWarm}" Classes.hot="{Binding IsHot}" />
                      <TextBlock Grid.Column="1" Text="{Binding Time}" Classes="mono" FontSize="12" Classes.warn="{Binding IsWarm}" Classes.bad="{Binding IsHot}" />
                      <TextBlock Grid.Column="2" Text="{Binding Where}" Classes="dim" FontSize="12" />
                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding Declaration}" Classes="mono" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding HotSpot}" Classes="dim mono" FontSize="11" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
                <TextBlock Classes="empty" Text="Profile a file to see how long Lean spends on each declaration." IsVisible="{Binding TimingItems.Count, Converter={x:Static vm:StatusConverters.IsZero}}" />
              </Panel>
            </DockPanel>
          </TabItem>
          <TabItem Header="REPL" ToolTip.Tip="Evaluate Lean in the context of the file at the cursor">
            <DockPanel Margin="8,4">
              <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,2">
                <TextBlock Text="›" Classes="mono" FontSize="15" VerticalAlignment="Center" Margin="2,0,6,0" Foreground="{DynamicResource GoalAccent}" />
                <TextBox Grid.Column="1" x:Name="ReplBox" Text="{Binding ReplInput}" Classes="mono" FontSize="13" KeyDown="OnReplKey"
                         PlaceholderText="An expression to evaluate, or a command (#check, example, def…). It runs in this file at the cursor. Enter runs; ↑ ↓ for history." />
                <Button Grid.Column="2" Classes="chip" Content="Clear" Command="{Binding ClearReplCommand}" Margin="6,0,0,0" />
              </Grid>
              <ProgressBar DockPanel.Dock="Bottom" IsIndeterminate="True" Height="2" MinHeight="2" IsVisible="{Binding ReplBusy}" />
              <Panel>
                <ListBox x:Name="ReplList" ItemsSource="{Binding ReplEntries}" Background="Transparent">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReplEntry">
                      <StackPanel Spacing="2" Margin="0,2">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <TextBlock Text="›" Classes="mono dim" Margin="0,0,6,0" />
                          <SelectableTextBlock Grid.Column="1" Text="{Binding Input}" Classes="mono" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="2" Text="{Binding Where}" Classes="dim" FontSize="10" VerticalAlignment="Center" />
                        </Grid>
                        <SelectableTextBlock Text="{Binding Output}" Classes="mono" TextWrapping="Wrap" Margin="14,0,0,0"
                                             Classes.error="{Binding IsError}" Opacity="0.9" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Classes="empty" IsVisible="{Binding ReplEntries.Count, Converter={x:Static vm:StatusConverters.IsZero}}"
                           Text="Try 2 ^ 64, #check Nat.add_comm, or a function from this file. Everything above the cursor is in scope." />
              </Panel>
            </DockPanel>
          </TabItem>
        </TabControl>
      </Grid>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="Transparent" />

      <!-- Right column: the goals, or the compiled C of the definition at the cursor -->
      <TabControl Grid.Column="4" Classes="panel" SelectedIndex="{Binding RightTab}" Padding="0">
        <TabItem Header="Goals">
          <v:InfoView DataContext="{Binding Info}" Background="{DynamicResource PanelBackground}" />
        </TabItem>
        <TabItem Header="Compiled C" ToolTip.Tip="The C that Lean's compiler emits for the definition at the cursor">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding CStatus}" TextWrapping="Wrap" FontSize="12" Margin="10,8" Classes="dim" />
            <ed:CodeView x:Name="CView" />
          </DockPanel>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
