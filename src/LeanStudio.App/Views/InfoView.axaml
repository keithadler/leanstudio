<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LeanStudio.App.ViewModels"
             xmlns:lsp="using:LeanStudio.Lsp"
             xmlns:v="using:LeanStudio.App.Views"
             x:Class="LeanStudio.App.Views.InfoView"
             x:DataType="vm:InfoViewModel">
  <Grid RowDefinitions="Auto,*,4,Auto">
    <!-- Header -->
    <Border Grid.Row="0" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Divider}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="Tactic State" FontWeight="SemiBold" FontSize="14" />
          <TextBlock Text="{Binding Position}" Classes="dim" FontSize="11" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Classes="chip accent" Command="{Binding Search.ProveCommand}"
                  ToolTip.Tip="Try rfl, decide, simp, omega, norm_num, linarith, aesop, grind, exact? and more on the sorry at the cursor, each on its own, and show which close it">
            <StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Data="{StaticResource IconBolt}" /><TextBlock Text="Prove it" /></StackPanel>
          </Button>
          <Button Classes="chip" Command="{Binding PinCommand}" ToolTip.Tip="Keep these goals on screen to compare with later ones">
            <StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Data="{StaticResource IconPin}" /><TextBlock Text="Pin" /></StackPanel>
          </Button>
          <ToggleButton Classes="chip" Content="English" IsChecked="{Binding ShowEnglish}" ToolTip.Tip="Read each goal aloud in English under it" />
          <ToggleButton Classes="chip" Content="Plain" IsChecked="{Binding PlainText}" ToolTip.Tip="Show the goals as the plain text Lean prints" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Goals -->
    <ScrollViewer Grid.Row="1" Padding="12,4,12,8">
      <StackPanel>
        <!-- Prove It -->
        <Border Classes="card" BorderThickness="3,0,0,0" BorderBrush="#E5B93A" IsVisible="{Binding Search.IsVisible}" Margin="0,4,0,6">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconBolt}" Width="13" Height="13" Foreground="#E5B93A" />
                <TextBlock Text="Prove It" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button Classes="chip" Content="Every sorry in the file" Command="{Binding Search.ProveAllCommand}" IsEnabled="{Binding !Search.IsRunning}"
                        ToolTip.Tip="Search for a proof of each sorry in this file, in one pass of Lean" />
                <Button Classes="flat" Content="×" FontSize="12" ToolTip.Tip="Close (and stop a running search)" Command="{Binding Search.CloseCommand}" />
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ProgressBar IsIndeterminate="True" Width="40" Height="4" MinHeight="4" IsVisible="{Binding Search.IsRunning}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Search.Status}" TextWrapping="Wrap" FontSize="12" Classes="dim" MaxWidth="360" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Search.Results}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SearchResultView">
                  <StackPanel Spacing="2" Margin="0,4,0,0">
                    <TextBlock Text="{Binding Title}" Classes="mono" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Verdict}" FontSize="11" Classes="dim" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Shown}" IsVisible="{Binding !IsApplied}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TrialView">
                          <Button Classes.accent="{Binding Closes}" Classes.flat="{Binding !Closes}" FontSize="11" Padding="8,2" Margin="0,2,4,2" ToolTip.Tip="{Binding Tip}"
                                  Command="{Binding $parent[UserControl].((vm:InfoViewModel)DataContext).Search.UseCommand}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Label}" Classes="mono" />
                              <TextBlock Text="{Binding Time}" Classes="dim" FontSize="10" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Fill in every sorry it proved" Classes="accent" Command="{Binding Search.FillAllCommand}" IsVisible="{Binding Search.CanFillAll}" FontSize="11" Padding="8,2" />
              <CheckBox Content="show the tactics that failed" IsChecked="{Binding Search.ShowFailures}" FontSize="11" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Pinned goals -->
        <ItemsControl ItemsSource="{Binding Pinned}" IsVisible="{Binding HasPinned}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PinnedGoal">
              <Border Classes="card" BorderThickness="3,0,0,0" BorderBrush="#B48EAD">
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Where, StringFormat='Pinned at {0}'}" FontSize="11" Classes="dim" />
                    <Button Grid.Column="1" Classes="flat" Content="×" FontSize="12" ToolTip.Tip="Unpin"
                            Command="{Binding $parent[UserControl].((vm:InfoViewModel)DataContext).UnpinCommand}" CommandParameter="{Binding}" />
                  </Grid>
                  <SelectableTextBlock Text="{Binding Text}" Classes="mono" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding Status}" Classes="dim" Margin="0,6,0,6" TextWrapping="Wrap" />

        <!-- Structured goals -->
        <ItemsControl ItemsSource="{Binding Goals}" IsVisible="{Binding !PlainText}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:GoalView">
              <Border Classes="card goal" Classes.closing="{Binding IsRemoved}" Classes.opened="{Binding IsInserted}">
                <StackPanel Spacing="2">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding CaseLabel}" IsVisible="{Binding HasCase}" Classes="mono" FontWeight="SemiBold" Foreground="{DynamicResource GoalAccent}" Margin="0,0,0,4" />
                    <TextBlock Grid.Column="1" Text="closed by this tactic" FontSize="11" Foreground="#3FB950" IsVisible="{Binding IsRemoved}" />
                    <TextBlock Grid.Column="1" Text="new goal" FontSize="11" Foreground="{DynamicResource GoalAccent}" IsVisible="{Binding IsInserted}" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Hypotheses}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:HypothesisView">
                        <Border Padding="4,1" CornerRadius="3"
                                Classes.inserted="{Binding IsInserted}" Classes.removed="{Binding IsRemoved}">
                          <Grid ColumnDefinitions="14,*">
                            <TextBlock Text="{Binding Marker}" Classes="mono dim" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                              <TextBlock Text="{Binding Names, StringFormat='{}{0} : '}" Classes="mono" Classes.struck="{Binding IsRemoved}" />
                              <v:SubtermText Tagged="{Binding Tagged}" Classes="mono" TextWrapping="Wrap" Classes.struck="{Binding IsRemoved}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Padding="4,3,4,1" Margin="0,4,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Prefix}" Classes="mono" FontWeight="SemiBold" />
                      <v:SubtermText Tagged="{Binding TargetTagged}" Classes="mono" FontWeight="SemiBold" TextWrapping="Wrap"
                                     ToolTip.ShowDelay="0" />
                    </StackPanel>
                  </Border>
                  <TextBlock Text="{Binding English}" Classes="dim" FontSize="12" FontStyle="Italic" TextWrapping="Wrap" Margin="4,2,4,0"
                             IsVisible="{Binding $parent[UserControl].((vm:InfoViewModel)DataContext).ShowEnglish}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Plain goals -->
        <SelectableTextBlock Text="{Binding PlainGoals}" Classes="mono" TextWrapping="Wrap" IsVisible="{Binding PlainText}" />

        <!-- Expected type -->
        <StackPanel IsVisible="{Binding HasExpectedType}">
          <TextBlock Text="EXPECTED TYPE" Classes="panelTitle" />
          <Border Classes="card">
            <SelectableTextBlock Text="{Binding ExpectedType}" Classes="mono" TextWrapping="Wrap" />
          </Border>
        </StackPanel>

        <!-- Messages -->
        <StackPanel IsVisible="{Binding HasMessages}">
          <TextBlock Text="MESSAGES" Classes="panelTitle" />
          <ItemsControl ItemsSource="{Binding Messages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MessageView">
                <Border Classes="card">
                  <StackPanel Spacing="6">
                    <SelectableTextBlock Text="{Binding Text}" Classes="mono" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Explanation}" IsVisible="{Binding HasExplanation}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource GoalAccent}" />
                    <ItemsControl ItemsSource="{Binding Suggestions}" IsVisible="{Binding HasSuggestions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="lsp:CodeAction">
                          <Button Classes="accent" FontSize="12" Padding="10,3" Margin="0,0,0,4" HorizontalAlignment="Left"
                                  Command="{Binding $parent[UserControl].((vm:InfoViewModel)DataContext).ApplySuggestionCommand}" CommandParameter="{Binding}">
  <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
</Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <GridSplitter Grid.Row="2" ResizeDirection="Rows" Background="Transparent" IsVisible="{Binding HasSteps}" />

    <!-- Proof steps -->
    <Border Grid.Row="3" MaxHeight="340" IsVisible="{Binding HasSteps}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Divider}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="12,8,12,4">
          <TextBlock Text="Proof Steps" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ProofName}" Classes="mono dim" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Steps}" Background="Transparent" x:Name="StepList" SelectionMode="Single" Tapped="OnStepTapped">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProofStepView">
              <Border Padding="4,2" CornerRadius="3" Classes.current="{Binding IsCurrent}" ToolTip.Tip="{Binding Explanation}">
                <Grid ColumnDefinitions="24,*,Auto" RowDefinitions="Auto,Auto">
                  <TextBlock Text="{Binding Number}" Classes="dim" FontSize="11" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Text}" Classes="mono" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding GoalsLabel}" Classes="dim" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                             IsVisible="{Binding !ClosesAll}" />
                  <TextBlock Grid.Column="2" Text="✓ done" Foreground="#3FB950" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding ClosesAll}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Summary}" FontSize="11" Classes="dim mono"
                             Classes.error="{Binding HasError}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.inserted">
      <Setter Property="Background" Value="{DynamicResource InsertedBackground}" />
    </Style>
    <Style Selector="Border.removed">
      <Setter Property="Background" Value="{DynamicResource RemovedBackground}" />
    </Style>
    <Style Selector="Border.goal">
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.goal.closing">
      <Setter Property="BorderBrush" Value="#3FB950" />
    </Style>
    <Style Selector="Border.goal.opened">
      <Setter Property="BorderBrush" Value="{DynamicResource GoalAccent}" />
    </Style>
    <Style Selector="Border.current">
      <Setter Property="Background" Value="{DynamicResource CurrentStepBackground}" />
    </Style>
    <Style Selector="TextBlock.struck">
      <Setter Property="TextDecorations" Value="Strikethrough" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="SelectableTextBlock.struck">
      <Setter Property="TextDecorations" Value="Strikethrough" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#F14C4C" />
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>
</UserControl>
