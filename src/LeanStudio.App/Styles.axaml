<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="TextBlock.panelTitle">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="Margin" Value="0,8,0,4" />
  </Style>
  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="JuliaMono, Cascadia Code, SF Mono, Menlo, Consolas, DejaVu Sans Mono, Noto Sans Mono, monospace" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.ok"><Setter Property="Foreground" Value="#3FB950" /></Style>
  <Style Selector="TextBlock.warn"><Setter Property="Foreground" Value="#E59E2C" /></Style>
  <Style Selector="Border.bar"><Setter Property="Background" Value="#6E8FA8" /></Style>
  <Style Selector="Border.bar.warm"><Setter Property="Background" Value="#E59E2C" /></Style>
  <Style Selector="Border.bar.hot"><Setter Property="Background" Value="#F14C4C" /></Style>
  <Style Selector="TextBlock.bad"><Setter Property="Foreground" Value="#F14C4C" /></Style>
  <Style Selector="TextBlock.dim">
    <Setter Property="Opacity" Value="0.65" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="TabControl.panel TabItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="7,0" />
  </Style>
  <Style Selector="TabStrip.docs TabStripItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,0,4,0" />
  </Style>
  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <!-- Chrome: menu, toolbar and tab strips share one surface; panels are divided by hairlines. -->
  <Style Selector="Menu.chrome">
    <Setter Property="Background" Value="{DynamicResource ChromeBackground}" />
    <Setter Property="Padding" Value="4,0" />
  </Style>
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{DynamicResource ChromeBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <Border Background="{DynamicResource Divider}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter[ResizeDirection=Columns] /template/ Border > Border">
    <Setter Property="Width" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="GridSplitter[ResizeDirection=Rows] /template/ Border > Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Toolbar buttons: flat, an icon and a label, a soft highlight on hover. -->
  <Style Selector="Button.tool">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
  </Style>
  <Style Selector="Button.tool PathIcon, Button.chip PathIcon, ToggleButton.chip PathIcon">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
  </Style>
  <Style Selector="Button.tool PathIcon.accent">
    <Setter Property="Foreground" Value="{DynamicResource GoalAccent}" />
  </Style>

  <!-- Chips: small outlined buttons and toggles for panel headers. -->
  <Style Selector="Button.chip, ToggleButton.chip">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter, ToggleButton.chip:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GoalAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource GoalAccent}" />
  </Style>
  <Style Selector="Button.chip.accent /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GoalAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource GoalAccent}" />
  </Style>

  <Style Selector="SelectableTextBlock.error"><Setter Property="Foreground" Value="#F14C4C" /></Style>

  <!-- File tree icons follow the theme. -->
  <Style Selector="PathIcon.folder"><Setter Property="Foreground" Value="{DynamicResource FolderBrush}" /></Style>
  <Style Selector="PathIcon.lean"><Setter Property="Foreground" Value="{DynamicResource LeanFileBrush}" /></Style>
  <Style Selector="PathIcon.plain"><Setter Property="Opacity" Value="0.6" /></Style>

  <!-- Empty panels say so, quietly. -->
  <Style Selector="TextBlock.empty">
    <Setter Property="Opacity" Value="0.55" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxWidth" Value="420" />
  </Style>

  <!-- Tab strips of the side and bottom panels. -->
  <Style Selector="TabControl.panel">
    <Setter Property="Background" Value="{DynamicResource ChromeBackground}" />
  </Style>
  <Style Selector="TabControl.panel /template/ ContentPresenter#PART_SelectedContentHost">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
  </Style>
  <Style Selector="TabControl.panel TabItem:selected">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TabStrip.docs">
    <Setter Property="Background" Value="{DynamicResource ChromeBackground}" />
  </Style>
  <Style Selector="TabStrip.docs TabStripItem:selected">
    <Setter Property="Background" Value="{DynamicResource EditorBackground}" />
  </Style>
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="CardBackground" Color="#262A31" />
          <SolidColorBrush x:Key="PanelBackground" Color="#1B1E23" />
          <SolidColorBrush x:Key="StatusBackground" Color="#2D5B9A" />
          <SolidColorBrush x:Key="InsertedBackground" Color="#2A3F2A" />
          <SolidColorBrush x:Key="RemovedBackground" Color="#4A2A2A" />
          <SolidColorBrush x:Key="GoalAccent" Color="#6FB3FF" />
          <SolidColorBrush x:Key="CurrentStepBackground" Color="#2F3847" />
          <SolidColorBrush x:Key="ChromeBackground" Color="#16181C" />
          <SolidColorBrush x:Key="EditorBackground" Color="#1E1E1E" />
          <SolidColorBrush x:Key="Divider" Color="#2C3038" />
          <SolidColorBrush x:Key="HoverBackground" Color="#2A2E36" />
          <SolidColorBrush x:Key="AccentSoft" Color="#1F3350" />
          <SolidColorBrush x:Key="FolderBrush" Color="#8FA7C4" />
          <SolidColorBrush x:Key="LeanFileBrush" Color="#6FB3FF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="CardBackground" Color="#F1F3F6" />
          <SolidColorBrush x:Key="PanelBackground" Color="#FAFAFB" />
          <SolidColorBrush x:Key="StatusBackground" Color="#2D6BC4" />
          <SolidColorBrush x:Key="InsertedBackground" Color="#DDF4DD" />
          <SolidColorBrush x:Key="RemovedBackground" Color="#F8DDDD" />
          <SolidColorBrush x:Key="GoalAccent" Color="#1F5FBF" />
          <SolidColorBrush x:Key="CurrentStepBackground" Color="#E2EAF6" />
          <SolidColorBrush x:Key="ChromeBackground" Color="#ECEEF2" />
          <SolidColorBrush x:Key="EditorBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Divider" Color="#D6D9DF" />
          <SolidColorBrush x:Key="HoverBackground" Color="#DFE3EA" />
          <SolidColorBrush x:Key="AccentSoft" Color="#DCE8FA" />
          <SolidColorBrush x:Key="FolderBrush" Color="#5A7394" />
          <SolidColorBrush x:Key="LeanFileBrush" Color="#1F5FBF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <!-- Icons, on a 16×16 grid, drawn for Lean Studio. -->
      <StreamGeometry x:Key="IconPlus">M7,2 H9 V7 H14 V9 H9 V14 H7 V9 H2 V7 H7 Z</StreamGeometry>
      <StreamGeometry x:Key="IconFolder">M1,3.5 C1,2.7 1.6,2 2.5,2 H6 L7.8,3.8 H13.5 C14.3,3.8 15,4.5 15,5.3 V12.5 C15,13.3 14.3,14 13.5,14 H2.5 C1.6,14 1,13.3 1,12.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconFile">F1 M3,1 H9.5 L13,4.5 V15 H3 Z M4.3,2.3 V13.7 H11.7 V5.4 H8.6 V2.3 Z</StreamGeometry>
      <StreamGeometry x:Key="IconLean">M4,2 H6.4 L13,14 H10.6 L8.4,10 L5.4,14 H3 L7.2,7.9 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSave">F1 M2,2 H11.5 L14,4.5 V14 H2 Z M4,3.3 V6.3 H10.5 V3.3 Z M4.5,8.8 V12.7 H11.5 V8.8 Z</StreamGeometry>
      <StreamGeometry x:Key="IconPlay">M4,2 L14,8 L4,14 Z</StreamGeometry>
      <StreamGeometry x:Key="IconStop">M3,3 H13 V13 H3 Z</StreamGeometry>
      <StreamGeometry x:Key="IconBuild">M9.6,1 L15,4.2 L13.8,5.8 L11.8,4.7 L10.6,6.2 L12,7.4 L4.7,15 C4.1,15.6 3.1,15.6 2.5,15 L1,13.5 C0.4,12.9 0.4,11.9 1,11.3 L8.6,4 L7.4,2.6 Z</StreamGeometry>
      <StreamGeometry x:Key="IconShield">F1 M8,0.8 L14.5,3 V8 C14.5,11.6 11.8,14.2 8,15.4 C4.2,14.2 1.5,11.6 1.5,8 V3 Z M7,11 L4.2,8.2 L5.4,7 L7,8.6 L10.7,4.9 L11.9,6.1 Z</StreamGeometry>
      <StreamGeometry x:Key="IconDownload">M7,1 H9 V8.2 L11.4,5.8 L12.8,7.2 L8,12 L3.2,7.2 L4.6,5.8 L7,8.2 Z M2,13 H14 V15 H2 Z</StreamGeometry>
      <StreamGeometry x:Key="IconRestart">M8,2 A6,6 0 1 0 14,8 H12 A4,4 0 1 1 8,4 V5.5 L11.5,3 L8,0.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconBolt">M9.5,0.5 L2.5,9 H7 L5.8,15.5 L13.5,6.5 H9 Z</StreamGeometry>
      <StreamGeometry x:Key="IconPin">M10.2,0.8 L15.2,5.8 L13.9,7.1 L12.8,6.7 L10.1,9.4 L10.6,12.4 L9.4,13.6 L6.6,10.8 L2.2,15.2 L0.8,15.2 L0.8,13.8 L5.2,9.4 L2.4,6.6 L3.6,5.4 L6.6,5.9 L9.3,3.2 L8.9,2.1 Z</StreamGeometry>
      <StreamGeometry x:Key="IconCheck">M6,11.2 L2.4,7.6 L3.8,6.2 L6,8.4 L12.2,2.2 L13.6,3.6 Z</StreamGeometry>
      <StreamGeometry x:Key="IconBook">F1 M1,2.5 C3,1.8 5.5,1.8 8,3 C10.5,1.8 13,1.8 15,2.5 V14 C13,13.3 10.5,13.3 8,14.5 C5.5,13.3 3,13.3 1,14 Z M2.3,3.4 V12.2 C4,11.8 5.6,11.9 7.3,12.6 V4.1 C5.6,3.3 4,3.1 2.3,3.4 Z M8.7,4.1 V12.6 C10.4,11.9 12,11.8 13.7,12.2 V3.4 C12,3.1 10.4,3.3 8.7,4.1 Z</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>
</Styles>
