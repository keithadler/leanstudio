<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <!-- Every public type and member in src/ carries a /// comment: a missing one is warning CS1591, an error here.
       The XML is for IDEs and the build's check; release builds leave it out. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
  </PropertyGroup>
</Project>
